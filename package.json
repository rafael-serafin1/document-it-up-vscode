{
  "name": "cml-vscode",
  "displayName": "Document It Up",
  "description": "Document It Up — Structured code navigation and documentation using the Commentary Markup Language.",
  "version": "0.6.9",
  "publisher": "Skrom",
  "repository": {
    "type": "git",
    "url": "https://github.com/rafael-serafin1/document-it-up-vscode.git"
  },
  "markdown": "github",
  "icon": "assets/images/docitup.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:cml.showLabels",
    "onCommand:cml.showHierarchy",
    "onCommand:cml.searchByAuthor"
  ],
  "license": "MIT",
  "keywords": [
    "documentation",
    "comment",
    "commentary",
    "cml",
    "comments",
    "navigation",
    "hierarchy",
    "markup",
    "tag-based",
    "tags",
    "html",
    "xml",
    "docs",
    "document",
    "semantic",
    "labels"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configurationDefaults": {
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": "entity.name.tag.cml",
            "settings": {
              "foreground": "#3FAF5A"
            }
          },
          {
            "scope": "punctuation.definition.tag.cml",
            "settings": {
              "foreground": "#808080"
            }
          }
        ]
      }
    },
    "grammars": [
      {
        "scopeName": "comment.cml.injection",
        "path": "./syntaxes/cml-tags.tmLanguage.json",
        "injectTo": [
          "source",
          "text.plain"
        ]
      }
    ],
    "commands": [
      {
        "command": "cml.showLabels",
        "title": "CML: Show Labels",
        "category": "CML",
        "icon": "$(group-by-ref-type)"
      },
      {
        "command": "cml.showHierarchy",
        "title": "CML: Show Hierarchy",
        "category": "CML",
        "icon": "$(list-tree)"
      },
      {
        "command": "cml.searchByAuthor",
        "title": "CML: Search by Author's Name",
        "category": "CML",
        "icon": "$(search-fuzzy)"
      }
    ],
    "keybindings": [
      {
        "command": "cml.showLabels",
        "key": "alt+k",
        "when": "editorTextFocus"
      },
      {
        "command": "cml.showHierarchy",
        "key": "alt+j",
        "when": "editorTextFocus"
      },
      {
        "command": "cml.searchByAuthor",
        "key": "alt+i",
        "when": "editorFocus"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "cml.showLabels",
          "group": "navigation@1",
          "when": "editorTextFocus"
        },
        {
          "command": "cml.showHierarchy",
          "group": "navigation@2",
          "when": "editorTextFocus"
        },
        {
          "command": "cml.searchByAuthor",
          "group": "navigation@3",
          "when": "editorTextFocus"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p .",
    "watch": "tsc -w -p ."
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@types/node": "^20.11.0",
    "typescript": "^5.6.0"
  }
}
